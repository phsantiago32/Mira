# ─── Supabase (frontend) ───────────────────────────────────────────────────────
# These values are safe to expose to the browser (anon / public key only).
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ─── Supabase Management API (server-side scripts only) ────────────────────────
# Personal Access Token – never commit this value; generate one at:
# https://supabase.com/dashboard/account/tokens
SUPABASE_TOKEN=<your-supabase-personal-access-token>

# The short project reference found in your Supabase project URL.
SUPABASE_PROJECT_REF=<your-supabase-project-ref>

# ─── Test credentials (used by puppeteer / auth test scripts) ──────────────────
# Regular test user
TEST_USER_EMAIL=<test-user@example.com>
TEST_USER_PASSWORD=<test-user-password>

# Admin test user
TEST_ADMIN_EMAIL=<admin@example.com>
TEST_ADMIN_PASSWORD=<admin-password>
